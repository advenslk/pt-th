# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required when running MidnightX as a standalone reverse-proxy server:
# Point this to your real Pterodactyl Panel v1.15.2 instance.
PTERODACTYL_URL="https://panel.example.com"
PTERODACTYL_CLIENT_API_KEY="ptlc_your_client_key"
# Optional: Required only for Admin Node/User/Egg management (/api/application/*)
PTERODACTYL_APP_API_KEY="ptla_your_application_key"

# Optional: External Billing & Support REST API (e.g. Paymenter / WHMCS / custom bridge)
# BILLING_API_URL="https://billing.example.com"
# BILLING_API_KEY="your_billing_api_token"
